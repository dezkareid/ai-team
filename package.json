{
  "name": "@dezkareid/ai-team",
  "version": "0.0.0",
  "description": "Repository for AI Team",
  "type": "module",
  "main": "index.js",
  "bin": {
    "ai-team-mcp": "./dist/mcp-server/index.js"
  },
  "scripts": {
    "sync-version": "node dist/scripts/sync-version.js",
    "distribute-mcp": "node dist/scripts/distribute-mcp.js",
    "build": "rollup -c",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run && npm run test:marketplace",
    "test:marketplace": "ajv validate -s schemas/marketplace.schema.json -d .claude-plugin/marketplace.json",
    "export-claude": "node dist/cli/export-claude.js",
    "apply-skill-changesets": "node dist/scripts/apply-skill-changesets.js",
    "apply-plugin-changesets": "node dist/scripts/apply-plugin-changesets.js",
    "prepare": "husky"
  },
  "keywords": [],
  "files": [
    "README.md",
    "AGENTS.md",
    "context",
    ".agent-structurerc"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dezkareid/ai-team.git"
  },
  "author": "Joel Humberto Gomez Paredes <elmaildeldezkareid@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/dezkareid/ai-team/issues"
  },
  "homepage": "https://github.com/dezkareid/ai-team#readme",
  "packageManager": "pnpm@10.30.1",
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@dezkareid/eslint-plugin-web": "1.2.0",
    "@eslint/js": "10.0.1",
    "@rollup/plugin-commonjs": "29.0.3",
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-typescript": "12.3.0",
    "@types/fs-extra": "11.0.4",
    "@types/node": "24.19.2",
    "@types/semver": "7.8.0",
    "ajv-cli": "5.0.0",
    "eslint": "10.13.0",
    "husky": "9.1.7",
    "rollup": "4.64.7",
    "tslib": "2.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@dezkareid/design-tokens": "1.5.0",
    "@iarna/toml": "2.2.5",
    "@modelcontextprotocol/sdk": "1.32.1",
    "fs-extra": "11.4.1",
    "semver": "7.8.5",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  }
}